{
  "name": "@schedulai/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "seed:dummy": "tsx src/scripts/seed-dummy-data.ts",
    "verify:semesters": "tsx src/scripts/verify-semesters.ts",
    "debug:generation": "tsx src/scripts/debug-generation.ts",
    "adjust:periods": "tsx src/scripts/adjust-periods.ts",
    "cleanup:batch-duplicates": "tsx src/scripts/cleanup-batch-duplicates.ts",
    "cleanup:course-duplicates": "tsx src/scripts/cleanup-course-duplicates.ts",
    "test:batch-detection": "tsx src/scripts/test-batch-detection.ts",
    "diagnostic:assignments": "tsx src/scripts/diagnostic-assignments.ts",
    "migrate:001-create-batches": "tsx src/scripts/migrations/001-create-batches.ts",
    "migrate:002-add-batch-references": "tsx src/scripts/migrations/002-add-batch-references.ts",
    "migrate:003-batch-aware-assignment-index": "tsx src/scripts/migrations/003-batch-aware-assignment-index.ts",
    "migrate:004-repair-stale-references": "cross-env DRY_RUN=false tsx src/scripts/migrations/004-repair-stale-references.ts",
    "migrate:005-normalize-semester-batches": "tsx src/scripts/migrations/005-normalize-semester-batches.ts",
    "migrate:reference-timetable": "tsx src/scripts/migrations/007-apply-reference-timetable.ts",
    "migrate:lab-block-periods": "tsx src/scripts/migrations/008-normalize-lab-block-periods.ts",
    "repair:dry-run": "cross-env DRY_RUN=true tsx src/scripts/migrations/004-repair-stale-references.ts"
  },
  "dependencies": {
    "@schedulai/config": "*",
    "@schedulai/shared-types": "*",
    "@schedulai/validation": "*",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^9.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
