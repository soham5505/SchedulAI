# Node Environment
NODE_ENV=development

# Server Ports
API_PORT=5000
WEB_PORT=5173
SCHEDULER_PORT=8000

# Database
MONGODB_URI=mongodb://localhost:27017/schedulai

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_chars_long_67890
JWT_REFRESH_EXPIRES_IN=7d

# Scheduler Service URL
SCHEDULER_URL=http://localhost:8000

# AI / LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
